#!/bin/sh
# 首次启动对齐 nginx 行为（幂等）。必须晚于 nginx-util 的 uci-defaults（60_*）。
[ -n "$IPKG_INSTROOT" ] && exit 0

# 1) 80→443 跳转由本包的 conf.d/luci-http.conf 提供（301），
#    这里去掉 nginx-util 自带的 _redirect2ssl，避免两条 80 server 打架
uci -q delete nginx._redirect2ssl
# 443 仍保留，用自签证书；配了 acme 证书后由 luci-app-nginx-proxy 使用
uci -q set nginx._lan.uci_manage_ssl='self-signed'
uci -q commit nginx

# 2) 兼容从旧镜像升级：旧版装的是 nginx-manager，它的 init 不是 rc.common 风格
#    （shebang 只有 #!/bin/sh），`disable` 是空操作，删不掉 rc.d 链接——必须自己删。
#    新版镜像不再包含该插件，这里只清理升级时被备份带回来的自启链接。
for f in /etc/rc.d/S??nginx_manager /etc/rc.d/K??nginx_manager; do
	[ -e "$f" ] && rm -f "$f"
done
if [ -x /etc/init.d/nginx_manager ]; then
	pgrep -f '/usr/sbin/nginx-manager-gen' >/dev/null 2>&1 && \
		/etc/init.d/nginx_manager stop >/dev/null 2>&1
fi

# 3) 让 nginx-guard 开机自检生效（它只在启动后跑一次，不是常驻进程）
/etc/init.d/nginx-guard enable >/dev/null 2>&1
/etc/init.d/nginx enable >/dev/null 2>&1

# 4) 60_* 可能已经带着 _redirect2ssl 起过一次 nginx，这里重启让新配置（301 跳转）立即生效。
if pidof nginx >/dev/null 2>&1; then
	/etc/init.d/nginx restart >/dev/null 2>&1
fi

exit 0
