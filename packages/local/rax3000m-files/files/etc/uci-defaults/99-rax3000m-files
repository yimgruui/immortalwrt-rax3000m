#!/bin/sh
# 首次启动把 UCI 对齐到本固件的预置方案（幂等，可重复执行）。
# 必须晚于 luci-app-pcdn-detector 的 uci-defaults，故命名为 99。
#
# 作用：把“壳”应用的参数指向镜像里预置的内核与配置，并补上开机自启。
# 内核二进制由 packages/local/* 安装，此处只做对齐与兜底。
# nikki 不做任何改动：保持其默认配置（fake-ip），由使用者自己换配置文件切换模式。

[ -n "$IPKG_INSTROOT" ] && exit 0

uci -q batch <<-EOF
	set pcdn-detector.main.enabled='1'
	set pcdn-detector.main.build_variant='c'
	set pcdn-detector.main.repo='Womsxd/pcdn-detector-c'
	set pcdn-detector.main.bin_path='/usr/bin/pcdn-detect'
	set pcdn-detector.main.config_path='/etc/pcdn-detect/pcdn-detect.toml'
	commit pcdn-detector

	set system.@system[0].hostname='RAX3000M'
	set system.@system[0].timezone='CST-8'
	set system.@system[0].zonename='Asia/Shanghai'
	commit system
EOF

# 打包过程偶有可执行位丢失，这里兜底
chmod 0755 /usr/bin/pcdn-detect 2>/dev/null

# 服务开机自启（镜像构建期 ipk 的 postinst 不执行，需在此补）
for svc in pcdn-detector nikki; do
	[ -x "/etc/init.d/$svc" ] && "/etc/init.d/$svc" enable >/dev/null 2>&1
done

# 系统升级时保留运行期生成的配置（这些文件不属于任何软件包的 conffiles）
for p in /etc/nginx/conf.d /etc/nginx/certs /etc/nginx-proxy /etc/device-key; do
	grep -qx "$p" /etc/sysupgrade.conf 2>/dev/null || echo "$p" >> /etc/sysupgrade.conf
done

# 兜底：/etc/device-key 只在装包时由 postinst 建一次，保留配置升级不会重跑 postinst；
# 目录不在时先补出来，页面/CLI 的状态才有地方落。
mkdir -p /etc/device-key && chmod 700 /etc/device-key

[ -x /etc/init.d/pcdn-detector ] && /etc/init.d/pcdn-detector restart >/dev/null 2>&1

exit 0
